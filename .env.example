# Copy to .env for LOCAL use. Never commit .env.
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-long-unique-password
DATABASE_URL=sqlite:///tiny-tale.db
COOKIE_SECURE=false

# Email OTP: fill only in private .env or Render environment settings.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=mnk9522@gmail.com
BREVO_SENDER_NAME=Tiny Tale
# Public customer URL (not the admin URL), e.g. your existing Render store URL
SITE_URL=https://tiny-tale-store.onrender.com

